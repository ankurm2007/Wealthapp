# Copy values into secrets.toml. Never commit secrets.toml to git.

[zerodha]
# Set once from https://developers.kite.trade — never share these
api_key = "your_kite_api_key"
# Permanent app secret from the same Kite Connect app page (NOT the daily access_token)
api_secret = "your_kite_api_secret"
# Optional; usually filled automatically after "Connect Zerodha" login in the sidebar
access_token = ""
redirect_url = "http://127.0.0.1:8501"

[openai]
api_key = "your_openai_api_key"
model = "gpt-4o-mini"

[alpha_vantage]
api_key = "your_alpha_vantage_key"

# Groq keys MUST start with gsk_  →  https://console.groq.com
[groq]
api_key = "gsk_..."

# xAI / Grok keys start with xai-  →  https://console.x.ai
# Do NOT put this under [groq]
[xai]
api_key = "xai-..."

[gemini]
api_key = "your_google_gemini_key"

# Financial Modeling Prep — Piotroski, OCF vs profit, Altman Z
# https://site.financialmodelingprep.com/developer/docs
[fmp]
api_key = "your_fmp_api_key"
